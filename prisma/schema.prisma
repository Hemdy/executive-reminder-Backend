generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                @id @default(cuid())
  title                String?
  firstName            String
  middleName           String?
  lastName             String
  email                String                @unique
  passwordHash         String
  role                 String                @default("EMPLOYEE")
  isActive             Boolean               @default(true)
  department           String?
  avatarUrl            String?
  roleId               String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  approvals            ApprovalRequest[]     @relation("ApprovalApprover")
  meetingsOrganized    Meeting[]             @relation("MeetingOrganizer")
  meetingComments      MeetingComment[]
  meetingAttachments   MeetingAttachment[]
  meetings             MeetingParticipant[]
  notifications        Notification[]
  notificationEvents   NotificationEvent[]
  notificationPreference NotificationPreference?
  pushSubscriptions    PushSubscription[]
  remindersCreated     Reminder[]            @relation("ReminderCreator")
  remindersReceived    Reminder[]            @relation("ReminderRecipient")
  reminderParticipants ReminderParticipant[]
  reminderComments     ReminderComment[]
  reminderAttachments  ReminderAttachment[]
  requestsAssigned     Request[]             @relation("RequestAssignee")
  requestsMade         Request[]             @relation("RequestRequester")
  requestComments      RequestComment[]
  requestAttachments   RequestAttachment[]
  tasksAssigned        Task[]                @relation("TaskAssignee")
  tasksCreated         Task[]                @relation("TaskCreator")
  taskAttachments      TaskAttachment[]
  taskComments         TaskComment[]
  taskParticipants     TaskParticipant[]
  roleRef              Role?                 @relation(fields: [roleId], references: [id])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isActive    Boolean          @default(true)
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id       String           @id @default(cuid())
  key      String           @unique
  action   String
  resource String
  roles    RolePermission[]

  @@unique([action, resource])
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Task {
  id           String            @id @default(cuid())
  title        String
  description  String?
  assignedToId String
  createdById  String
  priority     Priority
  category     String
  dueDate      DateTime
  dueTime      String?
  status       TaskStatus        @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignedTo   User              @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy    User              @relation("TaskCreator", fields: [createdById], references: [id])
  attachments  TaskAttachment[]
  comments     TaskComment[]
  participants TaskParticipant[]
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String   @map("content")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model TaskAttachment {
  id            String   @id @default(cuid())
  taskId        String
  uploaderId    String
  fileName      String
  mimeType      String
  size          Int
  storagePath   String?  @unique
  legacyContent Bytes?   @map("content")
  createdAt     DateTime @default(now())
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader      User     @relation(fields: [uploaderId], references: [id])

  @@index([taskId, createdAt])
}

model Reminder {
  id           String                @id @default(cuid())
  title        String
  description  String?
  recipientId  String
  createdById  String
  priority     Priority
  category     String
  reminderDate DateTime
  reminderTime String
  recurrence   ReminderRecurrence
  status       ReminderStatus        @default(PENDING)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  createdBy    User                  @relation("ReminderCreator", fields: [createdById], references: [id])
  recipient    User                  @relation("ReminderRecipient", fields: [recipientId], references: [id])
  participants ReminderParticipant[]
  comments     ReminderComment[]
  attachments  ReminderAttachment[]
}

model ReminderComment {
  id         String   @id @default(cuid())
  reminderId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  author     User     @relation(fields: [authorId], references: [id])
  reminder   Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId, createdAt])
}

model ReminderAttachment {
  id            String   @id @default(cuid())
  reminderId    String
  uploaderId    String
  fileName      String
  mimeType      String
  size          Int
  storagePath   String?  @unique
  legacyContent Bytes?   @map("content")
  createdAt     DateTime @default(now())
  uploader      User     @relation(fields: [uploaderId], references: [id])
  reminder      Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId, createdAt])
}

model Request {
  id           String           @id @default(cuid())
  title        String
  description  String?
  type         RequestType
  priority     Priority
  requesterId  String
  assignedToId String
  status       RequestStatus    @default(PENDING)
  dueDate      DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  approval     ApprovalRequest?
  assignedTo   User             @relation("RequestAssignee", fields: [assignedToId], references: [id])
  requester    User             @relation("RequestRequester", fields: [requesterId], references: [id])
  comments     RequestComment[]
  attachments  RequestAttachment[]
}

model RequestComment {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model RequestAttachment {
  id            String   @id @default(cuid())
  requestId     String
  uploaderId    String
  fileName      String
  mimeType      String
  size          Int
  storagePath   String?  @unique
  legacyContent Bytes?   @map("content")
  createdAt     DateTime @default(now())
  uploader      User     @relation(fields: [uploaderId], references: [id])
  request       Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model TaskParticipant {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model ReminderParticipant {
  reminderId String
  userId     String
  reminder   Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reminderId, userId])
}

model ApprovalRequest {
  id         String        @id @default(cuid())
  requestId  String        @unique
  approverId String
  status     RequestStatus @default(PENDING)
  approver   User          @relation("ApprovalApprover", fields: [approverId], references: [id])
  request    Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Meeting {
  id           String               @id @default(cuid())
  title        String
  description  String?
  agenda       String?
  organizerId  String
  meetingDate  DateTime
  startTime    String
  endTime      String
  location     String?
  meetingType  MeetingType
  status       MeetingStatus        @default(SCHEDULED)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  organizer    User                 @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  comments     MeetingComment[]
  attachments  MeetingAttachment[]
  participants MeetingParticipant[]
}

model MeetingParticipant {
  meetingId String
  userId    String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
}

model MeetingComment {
  id        String   @id @default(cuid())
  meetingId String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
}

model MeetingAttachment {
  id            String   @id @default(cuid())
  meetingId     String
  uploaderId    String
  fileName      String
  mimeType      String
  size          Int
  storagePath   String?  @unique
  legacyContent Bytes?   @map("content")
  createdAt     DateTime @default(now())
  uploader      User     @relation(fields: [uploaderId], references: [id])
  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
}

model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  endpoint       String   @unique
  p256dh         String
  auth           String
  expirationTime BigInt?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  userId    String   @id
  tasks     Boolean  @default(true)
  reminders Boolean  @default(true)
  requests  Boolean  @default(true)
  meetings  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationEvent {
  id        String   @id @default(cuid())
  userId    String
  eventKey  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([createdAt])
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  title         String
  message       String
  type          NotificationType
  priority      Priority
  isRead        Boolean          @default(false)
  sourceId      String?
  referenceId   String?
  resourceType  String?
  route         String?
  createdAt     DateTime         @default(now())
  eventKey      String?
  pushClaimedAt DateTime?
  pushSentAt    DateTime?
  pushAttempts  Int              @default(0)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryLogs  PushDeliveryLog[]

  @@unique([userId, eventKey])
  @@index([pushSentAt, pushClaimedAt])
}

enum PushDeliveryStatus {
  QUEUED
  SENT
  FAILED
}

model PushDeliveryLog {
  id             String             @id @default(cuid())
  notificationId String
  subscriptionId String?
  userId         String
  endpoint       String
  deviceType     String?
  status         PushDeliveryStatus @default(QUEUED)
  attempts       Int                @default(0)
  httpStatus     Int?
  errorDetails   String?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  notification   Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReminderRecurrence {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum ReminderStatus {
  PENDING
  TRIGGERED
  COMPLETED
  DISMISSED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RequestType {
  GENERAL
  APPROVAL
  DECISION
  DOCUMENT_REVIEW
  INFORMATION
  MEETING
  EXPENSE
  OTHER
}

enum RequestStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  NEEDS_INFORMATION
  COMPLETED
  CANCELLED
}

enum MeetingType {
  IN_PERSON
  ONLINE
  PHONE
  HYBRID
}

enum MeetingStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE
  TASK_OVERDUE
  TASK_UPDATED
  TASK_STATUS
  REMINDER
  REQUEST
  MEETING
  COMMENT
  SYSTEM
}
